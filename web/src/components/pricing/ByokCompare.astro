---
/**
 * "Registered post": what your own Resend key unlocks, next to a table comparing our sender with yours.
 */
import Icon from '../ui/Icon.astro';
import { limits, fmt } from '../../config/site';

const h = limits.digestHourUtc;
const digestAt = `${h % 12 || 12}${h < 12 ? 'am' : 'pm'} UTC`;

const byokRows = [
  { what: 'Email notifications', ours: `${fmt.n(limits.emailsPerDay)} a day`, yours: 'No cap from us' },
  { what: 'From address', ours: 'notify@sendm8.com', yours: 'forms@you.dev', mono: true },
  { what: 'Past the daily cap', ours: `The rest wait for the ${digestAt} digest`, yours: 'There isn’t one' },
  { what: 'Reply-To set to the sender', ours: 'Yes', yours: 'Yes' },
  { what: 'If something goes wrong', ours: 'We retry it for you', yours: 'Emails wait in your digest and the dashboard tells you. We never quietly switch you to our sender.' },
  { what: 'Cost from sendm8', ours: '0.00', yours: '0.00', mono: true },
];
---

<!-- BYOK -->
<section class="section byok band-ink" id="byok" aria-labelledby="byok-title">
  <div class="wrap byok-grid">
    <div class="byok-copy">
      <p class="bay label label-lg"><span class="bay-no">04</span> Registered post</p>
      <h2 id="byok-title" class="h1">Bring your own key, <br /><span class="byok-red">lose the cap.</span></h2>
      <p class="byok-lede">
        Paste a <strong>Resend</strong> API key into your account and every email notification goes through your Resend account instead of our shared sender.
        It still costs nothing from us.
      </p>
      <ul class="unlocks" role="list">
        <li>
          <Icon name="mail" size={20} />
          <div>
            <h3 class="h4">Unlimited email notifications</h3>
            <p>No daily cap from sendm8. Resend’s own plan sets how many you can send, and their free plan is plenty for most sites.</p>
          </div>
        </li>
        <li>
          <Icon name="send" size={20} />
          <div>
            <h3 class="h4">Your own From domain</h3>
            <p>Notifications come from an address on a domain you’ve verified with Resend, not from us.</p>
          </div>
        </li>
        <li>
          <Icon name="lock" size={20} />
          <div>
            <h3 class="h4">Locked away</h3>
            <p>Encrypted at rest and never shown in full again. Remove it whenever you like.</p>
          </div>
        </li>
      </ul>
      <div class="byok-cta">
        <a class="btn btn-signal" href="/docs#byok">Connect Resend <Icon name="arrow-right" /></a>
        <a class="btn btn-outline" href="/app/account/email">Account → Email</a>
      </div>
    </div>

    <div class="byok-table-wrap">
      <div class="table-wrap">
        <table class="table byok-table">
          <caption class="label">Our sender vs your Resend key</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col">Our sender</th>
              <th scope="col" class="col-yours">Your key</th>
            </tr>
          </thead>
          <tbody>
            {
              byokRows.map((r) => (
                <tr>
                  <th scope="row">{r.what}</th>
                  <td class:list={[r.mono && 'mono']}>{r.ours}</td>
                  <td class:list={['col-yours', r.mono && 'mono']}>{r.yours}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="byok-note">
        Discord, Slack, Telegram, webhooks and the dashboard inbox never touch the email cap, with or without a key.
      </p>
    </div>
  </div>
</section>

<style>
  /* ---------- BYOK ---------- */
  .byok-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .byok-copy .h1 {
    margin-top: var(--s-6);
  }
  .byok-red {
    color: var(--signal);
  }
  .byok-lede {
    margin-top: var(--s-5);
    max-width: 48ch;
    color: var(--fg-muted);
  }
  .byok-lede strong {
    color: var(--fg);
  }
  .unlocks {
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-4);
  }
  .unlocks li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .unlocks :global(svg) {
    color: var(--accent);
    margin-top: 0.1rem;
  }
  .unlocks p {
    margin-top: 0.25rem;
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    max-width: 50ch;
  }
  .byok-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .byok-table-wrap {
    position: sticky;
    top: 6rem;
    min-width: 0;
    margin-top: clamp(0rem, 6vw, 5rem);
  }
  .byok-table-wrap .table-wrap {
    border: 2px solid var(--line-strong);
    background: var(--bg-raised);
  }
  .byok-table {
    min-width: 30rem;
  }
  .byok-table caption {
    text-align: left;
    padding: 0.8rem 0.9rem;
    color: var(--fg-muted);
    border-bottom: 2px dashed var(--line);
  }
  .byok-table th[scope='row'] {
    font-family: var(--font-text);
    font-size: var(--fs-sm);
    letter-spacing: 0;
    text-transform: none;
    white-space: normal;
    color: var(--fg);
    font-weight: 600;
    text-align: left;
    padding: 0.8rem 0.75rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    width: 32%;
  }
  .byok-table td {
    color: var(--fg-muted);
  }
  .byok-table td.mono {
    font-size: var(--fs-xs);
  }
  .byok-table .col-yours {
    color: var(--fg);
    background: color-mix(in srgb, var(--signal) 12%, transparent);
  }
  .byok-table th.col-yours {
    color: var(--signal-text);
  }
  .byok-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .byok-note {
    margin-top: var(--s-4);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  @media (max-width: 1000px) {
    .byok-grid {
      grid-template-columns: 1fr;
    }
    .byok-table-wrap {
      position: static;
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .byok-table {
      min-width: 0;
    }
    .byok-table thead {
      display: none;
    }
    .byok-table,
    .byok-table tbody {
      display: block;
    }
    .byok-table caption {
      display: block;
    }
    .byok-table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      border-bottom: 1px solid var(--line);
    }
    .byok-table tbody tr:last-child {
      border-bottom: 0;
    }
    .byok-table th[scope='row'] {
      grid-column: 1 / -1;
      width: auto;
      border-bottom: 0;
      padding-bottom: 0.2rem;
    }
    .byok-table td {
      border-bottom: 0;
      padding-top: 0.4rem;
      font-size: var(--fs-xs);
      overflow-wrap: anywhere;
    }
    .byok-table td::before {
      display: block;
      margin-bottom: 0.2rem;
      font-family: var(--font-mono);
      font-size: var(--fs-2xs);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--fg-muted);
    }
    .byok-table td:nth-of-type(1)::before {
      content: 'Our sender';
    }
    .byok-table td:nth-of-type(2)::before {
      content: 'Your key';
      color: var(--signal-text);
    }
  }
  @media (max-width: 520px) {
    .byok-cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
