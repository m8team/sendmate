---
/**
 * Bay 08, file uploads: multipart forms and the size caps.
 */
import CodeBlock from '../../ui/CodeBlock.astro';
import DocsSection from './DocsSection.astro';
import { limits } from '../../../config/site';
import { FORM } from './docsSections';

const uploadCode = `
<form action="${FORM}" method="POST" enctype="multipart/form-data">
  <label>Your email <input name="email" type="email" required></label>
  <label>CV (PDF) <input name="cv" type="file" accept=".pdf"></label>
  <label>Screenshots <input name="screenshots" type="file" accept="image/*" multiple></label>
  <button>Send</button>
</form>`;
---

<DocsSection id="uploads" kicker="Multipart">
  <div class="prose">
    <p>
      Add <code>enctype="multipart/form-data"</code> to the form and use normal file inputs. Without the <code>enctype</code>, browsers send only the file
      name, not the file.
    </p>
  </div>

  <CodeBlock code={uploadCode} lang="html" filename="apply.html" highlight={[1, 3, 4]} class="wide" />

  <dl class="caps wide">
    <div>
      <dt class="label">Per file</dt>
      <dd>{limits.fileUploadMb} MB</dd>
    </div>
    <div>
      <dt class="label">Per submission</dt>
      <dd>{limits.submissionUploadMb} MB</dd>
    </div>
    <div>
      <dt class="label">Too big</dt>
      <dd>413</dd>
    </div>
  </dl>

  <div class="prose">
    <p>
      If any file is over the limit, the whole submission is refused with a <code>413</code>, so nothing arrives half-finished. It’s worth putting the
      limit next to the input, and checking <code>file.size</code> in the browser if you’re using AJAX.
    </p>
    <p>
      Files appear on the submission in your dashboard. Notification emails and channel messages include a link to download them rather than the files
      themselves, so nobody’s inbox fills up with attachments.
    </p>
  </div>
</DocsSection>

<style>
  .wide {
    max-width: 100%;
  }

  /* Upload caps */
  .caps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 2px solid var(--line-strong);
  }
  .caps div {
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
  }
  .caps div + div {
    padding-left: var(--s-4);
    border-left: 1px solid var(--line);
  }
  .caps dt {
    color: var(--fg-muted);
  }
  .caps dd {
    margin: var(--s-1) 0 0;
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: 900;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 0.9;
  }

  @media (max-width: 480px) {
    .caps {
      grid-template-columns: 1fr 1fr;
    }
    .caps div + div:last-child {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
