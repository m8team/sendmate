---
/**
 * Docs intro: the poster headline and "the short version" endpoint to copy.
 */
import CopyButton from '../ui/CopyButton.astro';
import { site } from '../../config/site';
---

<header class="docs-hero">
  <p class="docs-kicker">
    <span class="priority">Docs</span>
    <span class="label label-lg muted">Quickstart · about 12 minutes to read · 1 minute to do</span>
  </p>
  <h1 class="docs-h1">From form <br />to inbox.</h1>
  <div class="docs-intro">
    <p class="docs-lede">
      sendm8 is a URL you put in your form’s <code>action</code>. Everything on this page is optional extras. If you only read one thing, read the first
      section.
    </p>
    <div class="short">
      <p class="label short-label">The short version</p>
      <div class="endpoint">
        <code class="endpoint-url"
          ><span class="ep-base">&lt;form action="{site.endpointBase}</span><span class="ep-id">you@example.com</span><span class="ep-base">" method="POST"&gt;</span></code
        >
        <CopyButton text={`<form action="${site.endpointBase}you@example.com" method="POST">`} label="Copy" variant="outline" size="sm" />
      </div>
      <p class="short-hint">Swap in your email, submit once, click the link we send you. Done.</p>
      <p class="short-hint">Using an AI assistant? Give it <a href="/llms.txt">sendm8.com/llms.txt</a>: these docs as Markdown.</p>
    </div>
  </div>
</header>

<style>
  .docs-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    grid-template-areas: 'kicker kicker' 'title intro';
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem);
  }
  .docs-kicker {
    grid-area: kicker;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .docs-h1 {
    grid-area: title;
    margin-top: var(--s-5);
    font-family: var(--font-display);
    font-stretch: 64%;
    font-weight: 900;
    font-size: clamp(4.1rem, 10vw, 9.5rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
  }
  .docs-intro {
    grid-area: intro;
    min-width: 0;
    display: grid;
    gap: var(--s-5);
  }
  .docs-lede {
    font-size: var(--fs-lg);
    line-height: 1.45;
    max-width: 44ch;
  }
  .short {
    min-width: 0;
    padding: var(--s-4);
    border: 2px solid var(--line-strong);
    background: var(--bg-raised);
    box-shadow: var(--shadow-label);
  }
  .short-label {
    margin-bottom: var(--s-2);
    color: var(--signal-text);
  }
  .short-hint {
    margin-top: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .short-hint a {
    color: var(--signal-text);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .docs-hero {
      grid-template-columns: 1fr;
      grid-template-areas: 'kicker' 'title' 'intro';
      row-gap: var(--s-5);
    }
    .docs-hero {
      border-bottom: 0;
      padding-bottom: var(--s-5);
    }
    .docs-h1 {
      font-size: clamp(4.1rem, 19vw, 7rem);
    }
  }
</style>
