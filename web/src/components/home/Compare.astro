---
import { rows, us, competitors, checkedOn, checkedOnLabel, fairPoints } from '../../config/compare';
import { site } from '../../config/site';
const cols = [us, ...competitors];
---

<section class="section compare" id="compare" aria-labelledby="compare-title">
  <div class="wrap">
    <p class="bay label label-lg"><span class="bay-no">07</span> Honest comparison</p>

    <div class="cmp-head">
      <h2 id="compare-title" class="h1">How we stack up. <br /><span class="muted">No trash talk.</span></h2>
      <p class="cmp-note">Free plans only, taken from each service’s own pricing page and docs. Plans change, so if something’s out of date, <a class="link-signal" href={`${site.repo}/issues`}>tell us</a> and we’ll fix it.</p>
    </div>

    <div class="cmp-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
      <table class="cmp">
        <caption class="sr-only">Free plan comparison of sendm8 with other form backends</caption>
        <thead>
          <tr>
            <th scope="col" class="cmp-corner"><span class="label">Free plan</span></th>
            {
              cols.map((c, i) => (
                <th scope="col" class:list={[i === 0 && 'is-us']}>
                  <span class="cmp-name">{c.name}</span>
                  {c.note && <span class="label cmp-sub">{c.note}</span>}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, r) => (
              <tr>
                <th scope="row">{row}</th>
                {cols.map((c, i) => {
                  const cell = c.cells[r];
                  return (
                    <td class:list={[i === 0 && 'is-us', cell.tone && `t-${cell.tone}`]}>
                      {cell.tone && <span class={`cmp-mark m-${cell.tone}`} aria-hidden="true" />}
                      {cell.v}
                      {cell.note && <span class="cmp-cellnote">{cell.note}</span>}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="cmp-foot">
      <p class="cmp-legend label muted"><span><i class="cmp-mark m-yes"></i> yes</span><span><i class="cmp-mark m-part"></i> partly</span><span><i class="cmp-mark m-no"></i> no, or paid only</span><span class="cmp-swipe">← swipe the table →</span></p>
      <details class="cmp-src">
        <summary class="label">Checked <time datetime={checkedOn}>{checkedOnLabel}</time> · sources</summary>
        <ul role="list">
          {
            competitors.map((c) => (
              <li>
                <strong>{c.name}:</strong>{' '}
                {c.sources?.map((s, i) => (
                  <>
                    {i > 0 && ', '}
                    <a class="link-signal" href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a>
                  </>
                ))}
              </li>
            ))
          }
        </ul>
      </details>
    </div>

    <div class="fair">
      <h3 class="h3">Fair’s fair. What they do well:</h3>
      <ul role="list">
        {
          fairPoints.map((p) => (
            <li>
              <strong>{p.who}</strong> {p.what}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cmp-head > *,
  .fair > * {
    min-width: 0;
  }
  .cmp-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-6);
    align-items: end;
    margin-top: var(--s-7);
  }
  .cmp-note {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .cmp-scroll {
    margin-top: var(--s-6);
    overflow-x: auto;
    border-top: 2px solid var(--line-strong);
    border-bottom: 2px solid var(--line-strong);
    scrollbar-width: thin;
  }
  .cmp {
    width: 100%;
    min-width: 48rem;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
  }
  .cmp th,
  .cmp td {
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .cmp tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cmp thead th {
    vertical-align: bottom;
    border-bottom: 1px solid var(--line-strong);
  }
  .cmp tbody th {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 13rem;
    background: var(--bg);
    font-weight: 600;
    border-right: 1px solid var(--line);
  }
  .cmp-corner {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg);
    border-right: 1px solid var(--line);
    color: var(--fg-muted);
  }
  .cmp-name {
    display: block;
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.05;
  }
  .cmp-sub {
    display: block;
    margin-top: 0.2rem;
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0;
  }
  .cmp-cellnote {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    color: var(--fg-muted);
  }
  .cmp .is-us {
    background: var(--fg);
    color: var(--bg);
    border-bottom-color: color-mix(in srgb, var(--bg) 20%, transparent);
  }
  .cmp .is-us .cmp-cellnote {
    color: color-mix(in srgb, var(--bg) 72%, var(--fg));
  }
  .cmp thead .is-us .cmp-name {
    font-size: 1.45rem;
  }
  .cmp thead .is-us {
    position: relative;
  }
  .cmp thead .is-us::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: var(--signal-mark);
  }
  .cmp-mark {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.45rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    vertical-align: 0.02em;
  }
  .m-yes {
    color: var(--ok);
    background: currentColor;
  }
  .m-part {
    color: var(--warn);
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
  .m-no {
    color: var(--fg-subtle);
  }
  .is-us .cmp-mark {
    color: var(--bg);
  }
  .t-no {
    color: var(--fg-muted);
  }
  .t-part .cmp-mark {
    color: var(--warn);
  }
  .cmp-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-3);
  }
  .cmp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .cmp-swipe {
    display: none;
  }
  .cmp-src summary {
    cursor: pointer;
    color: var(--fg-muted);
  }
  .cmp-src summary:hover {
    color: var(--fg);
  }
  .cmp-src[open] {
    flex-basis: 100%;
  }
  .cmp-src ul {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .cmp-src strong {
    color: var(--fg);
  }
  .fair {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--s-6);
    margin-top: var(--s-7);
  }
  .fair ul {
    display: grid;
    gap: var(--s-3);
  }
  .fair li {
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .fair strong {
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .cmp-head,
    .fair {
      grid-template-columns: 1fr;
    }
    .cmp-swipe {
      display: inline;
    }
    .cmp tbody th {
      width: 9rem;
      min-width: 9rem;
    }
  }
</style>
