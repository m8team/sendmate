---
import Logo from './Logo.astro';
import Postmark from './Postmark.astro';
import Icon from '../ui/Icon.astro';
import CopyButton from '../ui/CopyButton.astro';
import { site } from '../../config/site';
import { MONTHS } from '../../mocks';

const built = new Date();
const day = `${String(built.getDate()).padStart(2, '0')} ${MONTHS[built.getMonth()].toUpperCase()}`;
const year = String(built.getFullYear());

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/docs', label: 'Quickstart' },
      { href: '/pricing', label: 'Pricing (it’s free)' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/#compare', label: 'Compare' },
      { href: '/docs#byok', label: 'Bring your own Resend key' },
      { href: '/docs#formspree', label: 'Moving from Formspree' },
      { href: '/llms.txt', label: 'Docs for AI assistants' },
    ],
  },
  {
    title: 'Dashboard',
    links: [
      { href: '/app/sign-in', label: 'Sign in' },
      { href: '/app/onboarding', label: 'Create a form' },
      { href: '/app', label: 'Your forms' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { href: site.repo, label: 'Source on GitHub', external: true },
      { href: '/#self-host', label: 'Self-host it' },
      { href: `${site.repo}/blob/main/LICENSE`, label: `Licence: ${site.license}`, external: true },
    ],
  },
  {
    title: 'The small print',
    links: [
      { href: '/terms', label: 'Terms of service' },
      { href: '/privacy', label: 'Privacy policy' },
      { href: `mailto:${site.abuseEmail}`, label: 'Report abuse' },
      { href: `mailto:${site.helloEmail}`, label: 'Say hello' },
      { href: '/pages', label: 'Every page in this mockup' },
    ],
  },
];
---

<footer class="site-footer band-ink">
  <div class="wrap sf-top">
    <div class="sf-pitch">
      <p class="label sf-kicker">Last stop</p>
      <p class="sf-line">Got a form? <span>Send it, mate.</span></p>
      <div class="endpoint sf-endpoint">
        <code class="endpoint-url"><span class="ep-base">{site.endpointBase}</span><span class="ep-id">you@example.com</span></code>
        <CopyButton text={`${site.endpointBase}you@example.com`} label="Copy" variant="outline" size="sm" />
      </div>
      <p class="sf-hint muted">Swap in your email, paste it into your form's <code>action</code>, and that's the whole setup.</p>
    </div>

    <nav class="sf-cols" aria-label="Footer">
      {
        cols.map((col) => (
          <div class="sf-col">
            <h2 class="label">{col.title}</h2>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} {...('external' in l && l.external ? { rel: 'noopener', target: '_blank' } : {})}>
                    {l.label}
                    {'external' in l && l.external && <Icon name="arrow-up-right" size={12} strokeWidth={2} />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap sf-mid">
    <Postmark top="SORTING OFFICE" bottom="PAID BY NOBODY" center={day} sub={year} size={96} tone="signal" class="sf-postmark" />
    <ul class="sf-notes" role="list">
      <li>No tracking pixels in our emails. Only tracking numbers.</li>
      <li>No “free tier” countdown. No card on file. No sales team to escape.</li>
      <li>Built on Cloudflare's free plan, and stubborn about staying there.</li>
    </ul>
  </div>

  <div class="sf-giant" aria-hidden="true">
    <span>sendm8</span>
  </div>

  <div class="wrap sf-base">
    <Logo size="sm" />
    <p class="label">© {year} sendm8 contributors · {site.license} · Return address: {site.repoShort}</p>
  </div>
</footer>

<style>
  .sf-top > *,
  .sf-cols > * {
    min-width: 0;
  }
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-top: var(--s-9);
  }
  .sf-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-8);
  }
  .sf-kicker {
    color: var(--signal-text);
    margin-bottom: var(--s-3);
  }
  .sf-line {
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: 900;
    font-size: clamp(2.8rem, 6.4vw, 6rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
  }
  .sf-line span {
    display: block;
    color: var(--signal);
  }
  .sf-endpoint {
    margin-top: var(--s-6);
    max-width: 34rem;
  }
  .sf-hint code {
    white-space: normal;
  }
  .sf-hint {
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    max-width: 40ch;
  }
  .sf-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    align-content: start;
  }
  .sf-col h2 {
    color: var(--fg-muted);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }
  .sf-col ul {
    display: grid;
    gap: var(--s-2);
  }
  .sf-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .sf-col a:hover {
    text-decoration: underline;
    color: var(--signal-text);
  }
  .sf-mid {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    margin-top: var(--s-8);
    padding-block: var(--s-5);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .sf-mid :global(.sf-postmark) {
    flex: none;
    width: min(240px, 50vw);
  }
  .sf-notes {
    display: grid;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .sf-notes li::before {
    content: '✕ ';
    color: var(--signal-text);
  }
  .sf-giant {
    margin-top: var(--s-6);
    line-height: 0.74;
    height: clamp(5rem, 20vw, 20rem);
    overflow: hidden;
    user-select: none;
  }
  .sf-giant span {
    display: block;
    font-family: var(--font-display);
    font-stretch: var(--stretch-condensed);
    font-weight: 900;
    font-size: clamp(8rem, 36vw, 38rem);
    letter-spacing: -0.03em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
    opacity: 0.22;
    transform: translateY(-2%);
  }
  .sf-base {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-block: var(--s-4) var(--s-5);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .sf-base .label {
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .sf-top {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .sf-mid {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
