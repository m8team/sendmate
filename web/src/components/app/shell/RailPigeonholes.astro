---
/**
 * The rail's form list: skeletons in the static build, filled in the browser by
 * railPigeonholes.ts from the <template> below (so the clones keep this component's styles).
 */
---

<ul role="list" class="holes" data-holes aria-busy="true">
  {
    [62, 48, 70].map((w) => (
      <li data-hole-skel aria-hidden="true">
        <span class="hole hole-skel">
          <span class="hole-dot s-skel" />
          <span class="skel" style={`width:${w}%;height:0.7rem`} />
        </span>
      </li>
    ))
  }
  <li data-holes-empty hidden>
    <p class="holes-note">No forms yet.</p>
  </li>
  <li data-holes-error hidden>
    <p class="holes-note">
      Couldn’t load forms. <button type="button" class="holes-retry" data-holes-retry>Try again</button>
    </p>
  </li>
</ul>
<template data-hole-tpl>
  <li>
    <a class="hole" href="/app">
      <span class="hole-dot" aria-hidden="true"></span>
      <span class="hole-name"></span>
      <span class="hole-sub mono" hidden></span>
      <span class="hole-count" hidden></span>
    </a>
    <ul role="list" class="hole-pages" hidden>
      <li><a class="hole-page" href="/app" data-hole-inbox>Inbox</a></li>
      <li><a class="hole-page" href="/app" data-hole-settings>Settings</a></li>
    </ul>
  </li>
</template>

<style>
  /* Nested under "Forms", with a guide line, so the list reads as its children. */
  .holes {
    display: grid;
    gap: 1px;
    margin: 1px 0 0 1.05rem;
    padding-left: 0.4rem;
    border-left: 1px solid var(--line);
  }
  .hole {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-2);
    font-size: var(--fs-sm);
    text-decoration: none;
    color: var(--fg-muted);
    min-width: 0;
  }
  .hole:hover {
    background: var(--bg);
    color: var(--fg);
  }
  .hole[aria-current='page'],
  .hole.is-open {
    color: var(--fg);
    font-weight: 600;
  }
  .hole[aria-current='page'] {
    background: var(--bg);
  }
  .hole-pages {
    display: grid;
    gap: 1px;
    margin: 1px 0 var(--s-1) 0.6rem;
  }
  .hole-pages[hidden] {
    display: none;
  }
  .hole-page {
    display: block;
    padding: 0.2rem 0.6rem;
    border-radius: var(--r-2);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .hole-page:hover {
    background: var(--bg);
    color: var(--fg);
  }
  .hole-page[aria-current='page'] {
    background: var(--bg);
    color: var(--fg);
    font-weight: 600;
  }
  /* Only a form that needs attention gets a dot; active forms stay quiet. */
  .hole-dot {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--fg-subtle);
    opacity: 0.6;
  }
  .hole-dot.s-active {
    display: none;
  }
  .hole-dot.s-paused {
    background: transparent;
    border: 1.5px solid var(--fg-muted);
    opacity: 1;
  }
  .hole-dot.s-pending_confirmation {
    background: var(--warn);
    opacity: 1;
  }
  .hole-dot.s-disabled {
    background: var(--signal);
    opacity: 1;
  }
  .hole-name {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hole-sub {
    flex: none;
    font-size: var(--fs-2xs);
    color: var(--fg-subtle);
  }
  .hole-count {
    flex: none;
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .hole-skel {
    pointer-events: none;
  }
  .hole-dot.s-skel {
    display: none;
  }
  .holes-note {
    padding: 0.3rem 0.6rem;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .holes-retry {
    border: 0;
    padding: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
