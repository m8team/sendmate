---
/**
 * The dashboard rail: Forms with each form nested under it (the open form shows its Inbox and
 * Settings), account Settings, Admin, and the account at the bottom.
 * A sticky sidebar on wide screens, a drawer opened from the topbar's menu button below 960px.
 * Everything user-specific is filled in by the scripts below; the static build ships skeletons.
 */
import Logo from '../../brand/Logo.astro';
import Icon from '../../ui/Icon.astro';
import ThemeToggle from '../../ui/ThemeToggle.astro';
import RailPigeonholes from './RailPigeonholes.astro';

interface Props {
  /** 'forms' | 'new' | 'email' | 'admin' | 'form' (the form is read from the URL) */
  active: string;
}
const { active } = Astro.props;
---

<aside class="rail" id="app-rail" aria-label="Dashboard" transition:persist="app-rail">
  <div class="rail-top">
    <Logo href="/app" size="sm" />
    <button type="button" class="icon-btn rail-close" data-rail-close>
      <Icon name="x" size={16} /><span class="sr-only">Close menu</span>
    </button>
  </div>

  <nav class="rail-nav" aria-label="Dashboard sections">
    <div class="rail-group">
      <a class="rail-link" href="/app" data-rail-section="forms" aria-current={active === 'forms' ? 'page' : undefined}>
        <Icon name="grid" size={16} /> Forms
      </a>
      <a class="rail-add" href="/app/onboarding" data-rail-section="new" aria-label="New form" title="New form" aria-current={active === 'new' ? 'page' : undefined}><Icon name="plus" size={14} /></a>
    </div>
    <RailPigeonholes />

    <a class="rail-link rail-gap" href="/app/account/email" data-rail-section="email" aria-current={active === 'email' ? 'page' : undefined}>
      <Icon name="settings" size={16} /> Settings
    </a>
    <a class="rail-link" href="/app/admin" data-rail-section="admin" aria-current={active === 'admin' ? 'page' : undefined} data-admin-link hidden>
      <Icon name="shield" size={16} /> Admin
    </a>
  </nav>

  <div class="rail-bottom">
    <a class="rail-usage" href="/app/account/email">
      <span class="rail-usage-row"><span>Emails today</span><span class="tabular" data-usage-count>··/··</span></span>
      <span class="meter" data-usage-meter style="--pct:0%" aria-hidden="true"></span>
    </a>
    <div class="rail-account">
      <span class="avatar" aria-hidden="true" data-account-initials>··</span>
      <span class="rail-who">
        <span class="rail-name" data-account-name><span class="skel" style="width:7rem;height:0.8rem;margin-block:0.15rem"></span></span>
        <span class="rail-mail" data-account-mail><span class="skel" style="width:9rem;height:0.6rem;margin-top:0.2rem"></span></span>
      </span>
      <ThemeToggle />
    </div>
    <button type="button" class="rail-link rail-signout" data-signout><Icon name="logout" size={16} /> Sign out</button>
  </div>
</aside>
<div class="rail-scrim" data-rail-close aria-hidden="true" transition:persist="app-rail-scrim"></div>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--bg-sunk);
    border-right: 1px solid var(--line);
    overflow-y: auto;
  }
  .rail-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--app-topbar-h);
    padding: 0 var(--s-4);
  }
  .rail-close {
    display: none;
  }
  .rail-nav {
    padding: 0 var(--s-2) var(--s-3);
    display: grid;
    gap: 1px;
    align-content: start;
  }
  .rail-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--fg-muted);
  }
  .rail-link:hover {
    background: var(--bg);
    color: var(--fg);
  }
  .rail-link[aria-current='page'] {
    background: var(--bg);
    color: var(--fg);
    font-weight: 600;
  }
  /* Forms and its + share a row; the + sits over the right end of the link. */
  .rail-group {
    position: relative;
  }
  .rail-group .rail-link {
    padding-right: 2.25rem;
  }
  .rail-add {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    transform: translateY(-50%);
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--r-2);
    color: var(--fg-muted);
  }
  .rail-add:hover,
  .rail-add[aria-current='page'] {
    background: var(--bg-sunk);
    color: var(--fg);
  }
  .rail-gap {
    margin-top: var(--s-2);
  }
  .rail-signout {
    width: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  /* :global() because this img is inserted client-side (railAccount.ts), so it never gets
     Astro's scoping attribute and a plain `.avatar img` selector would never match it. */
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .rail-bottom {
    margin-top: auto;
    padding: var(--s-3) var(--s-2);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-2);
  }
  .rail-usage {
    display: grid;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-2);
    text-decoration: none;
  }
  .rail-usage:hover {
    background: var(--bg);
  }
  .rail-usage-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .rail-account {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding-inline: 0.6rem 0;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--bg-deep);
    font-size: var(--fs-2xs);
    font-weight: 600;
  }
  .rail-who {
    flex: 1;
    min-width: 0;
    display: grid;
    line-height: 1.25;
  }
  .rail-name {
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .rail-mail {
    font-size: var(--fs-2xs);
    color: var(--fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rail-scrim {
    display: none;
  }

  @media (max-width: 960px) {
    .rail {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: var(--z-overlay);
      width: min(18rem, 86vw);
      transform: translateX(-102%);
      transition: transform var(--dur-3) var(--ease-out);
      box-shadow: 0 0 40px rgb(0 0 0 / 0.25);
    }
    :global(.rail-is-open) .rail {
      transform: none;
    }
    :global(.rail-is-open) .rail-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: calc(var(--z-overlay) - 1);
      background: color-mix(in srgb, var(--ink-900) 45%, transparent);
    }
    .rail-close {
      display: inline-grid;
    }
  }
</style>

<script>
  import { setUnauthorizedHandler } from '../../../lib/api/client';
  import { friendlyError } from '../../../lib/api/errors';
  import { guardSession, signInUrl } from '../../../lib/api/session';
  import { DATA_REFRESHED, clearCache, loadEmailSettings, loadMe } from '../../../lib/api/store';
  import { toast } from '../../../lib/toast';
  import { mountAccount } from './railAccount';
  import { mountPigeonholes } from './railPigeonholes';
  import { railSection } from './railFormat';

  /*
   * The rail is kept across client-side navigation (transition:persist in AppRail), so this runs once
   * per visit. Anything that depends on the page (which link is current, which form is open) is
   * re-applied after every swap instead of being baked into the HTML.
   */

  // ---- Drawer (narrow screens): the topbar's menu button opens it; close, scrim or Escape shut it.
  const root = document.documentElement;
  const rail = document.getElementById('app-rail');
  const openButton = () => document.querySelector<HTMLButtonElement>('[data-rail-open]');
  const setOpen = (open: boolean, moveFocus = true) => {
    root.classList.toggle('rail-is-open', open);
    openButton()?.setAttribute('aria-expanded', String(open));
    if (!moveFocus) return;
    if (open) rail?.querySelector<HTMLElement>('a, button')?.focus();
    else openButton()?.focus();
  };
  // Delegated: the topbar (and its menu button) is replaced on every navigation.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-rail-open]')) setOpen(true);
    else if (target.closest('[data-rail-close]')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.classList.contains('rail-is-open')) setOpen(false);
  });

  // ---- Data
  // Any 401 from any island means the session ended: forget what we cached and go to sign-in.
  setUnauthorizedHandler(() => {
    clearCache();
    window.location.replace(signInUrl());
  });

  const pigeonholes = mountPigeonholes();
  const account = mountAccount();

  /** Mark the section link for the current URL. Forms in the list are handled by syncActive(). */
  function markSection() {
    const current = railSection(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('[data-rail-section]').forEach((a) => {
      if (a.dataset.railSection === current) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  async function boot() {
    const me = await guardSession().catch((err) => {
      toast(friendlyError(err), 6000);
      return null;
    });
    if (!me) return;
    account.show(me);
    pigeonholes.refresh();
    account.refreshUsage();
    account.showAdminLink(me);
  }

  window.addEventListener(DATA_REFRESHED, async (e) => {
    const { key } = (e as CustomEvent<{ key: string }>).detail;
    if (key === 'me') {
      const me = await loadMe();
      account.show(me);
      account.showAdminLink(me);
    } else if (key === 'email-settings') {
      await loadEmailSettings();
      account.refreshUsage();
    }
  });

  /**
   * Once the browser is idle, fetch each dashboard page's scripts ahead of time (modulepreload), so the
   * first visit to a page in a session doesn't wait on its JavaScript. Form pages all share one shell,
   * so one inbox and one settings page cover every form.
   */
  function warmPages() {
    const preloaded = new Set<string>();
    const preload = (href: string | null) => {
      if (!href || preloaded.has(href)) return;
      preloaded.add(href);
      const link = document.createElement('link');
      link.rel = 'modulepreload';
      link.href = href;
      document.head.appendChild(link);
    };
    const pages = new Set(['/app/', '/app/onboarding/', '/app/account/email/']);
    const form = document.querySelector<HTMLElement>('[data-hole]')?.dataset.hole;
    if (form) {
      pages.add(`/app/forms/${form}`);
      pages.add(`/app/forms/${form}/settings`);
    }
    if (!document.querySelector<HTMLElement>('[data-admin-link]')?.hidden) pages.add('/app/admin/');
    pages.delete(location.pathname);
    for (const page of pages) {
      fetch(page, { credentials: 'same-origin' })
        .then((res) => (res.ok ? res.text() : ''))
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          doc.querySelectorAll('astro-island').forEach((island) => {
            preload(island.getAttribute('component-url'));
            preload(island.getAttribute('renderer-url'));
          });
          doc.querySelectorAll<HTMLScriptElement>('script[type="module"][src]').forEach((script) => preload(script.getAttribute('src')));
        })
        .catch(() => {
          /* only a head start; the page still loads normally */
        });
    }
  }
  // Safari has no requestIdleCallback: a short delay does the same job there.
  const whenIdle = (fn: () => void) => (typeof window.requestIdleCallback === 'function' ? window.requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 1500));

  document.addEventListener('astro:after-swap', () => {
    setOpen(false, false);
    markSection();
    pigeonholes.syncActive();
  });

  markSection();
  boot().then(() => whenIdle(warmPages));
</script>
