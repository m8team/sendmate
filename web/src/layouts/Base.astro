---
import '../styles/base.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  bodyClass?: string;
  /** Path under /public to a 1200×630 social card. Defaults to the site-wide one. */
  image?: string;
}
const { title, description = site.description, noindex = false, bodyClass, image = '/og/og-default.png' } = Astro.props;
const fullTitle = title ? `${title} · sendm8` : `sendm8 — ${site.tagline} Free, open-source form backend`;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);

// Sitewide entity graph: who sendm8 is, once, so Google can link every page's content
// back to the same Organization/WebSite instead of guessing. Page-specific structured
// data (SoftwareApplication on the homepage, BreadcrumbList on docs pages) is additional.
const entityLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: 'sendm8',
      url: site.url,
      logo: `${site.url}/icon-512.png`,
      sameAs: [site.repo],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: 'sendm8',
      url: site.url,
      publisher: { '@id': `${site.url}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="sendm8" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="sendm8 — your form's got mail. Free, open-source form backend." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f2ede2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(entityLd)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function stored() {
          try {
            return localStorage.getItem('sendm8-theme');
          } catch (e) {
            return null;
          }
        }
        function apply() {
          var t = stored();
          root.dataset.theme = t === 'dark' || (t !== 'light' && mq.matches) ? 'dark' : 'light';
        }
        apply();
        mq.addEventListener('change', function () {
          if (!stored()) apply();
        });
        window.__sendm8Theme = apply;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <div class="toast-region" aria-live="polite" role="status" data-toasts></div>
    <script>
      import { installErrorReporter } from '../lib/error-reporter';
      import { toast } from '../lib/toast';

      installErrorReporter();

      async function copyText(text: string) {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
      }

      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy], [data-copy-target]');
        if (!btn) return;
        let text = btn.dataset.copy;
        if (!text && btn.dataset.copyTarget) {
          const el = document.querySelector<HTMLElement>(btn.dataset.copyTarget);
          text = el?.innerText.replace(/\n$/, '');
        }
        if (!text) return;
        await copyText(text);
        btn.classList.add('is-copied');
        toast(btn.dataset.copyToast ?? 'Copied to clipboard');
        window.setTimeout(() => btn.classList.remove('is-copied'), 1800);
      });
    </script>
  </body>
</html>
