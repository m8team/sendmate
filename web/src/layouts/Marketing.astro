---
import Base from './Base.astro';
import SiteHeader from '../components/brand/SiteHeader.astro';
import SiteFooter from '../components/brand/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <SiteHeader />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
</Base>
