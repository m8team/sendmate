---
import App from '../../layouts/App.astro';
import OnboardingFlow from '../../components/app/OnboardingFlow.vue';
---

<App title="New form" active="new" crumbs={[{ label: 'Forms', href: '/app' }, { label: 'New form' }]}>
  <header class="app-head">
    <div>
      <h1 class="app-title">New form</h1>
      <p class="app-sub">Name it, choose where submissions go, then add the snippet to your site.</p>
    </div>
  </header>

  <OnboardingFlow client:load />
</App>
