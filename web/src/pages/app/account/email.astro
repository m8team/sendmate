---
import App from '../../../layouts/App.astro';
import ResendKey from '../../../components/app/ResendKey.vue';
---

<App title="Settings" active="email" crumbs={[{ label: 'Settings' }]}>
  <header class="app-head">
    <div>
      <h1 class="app-title">Settings</h1>
      <p class="app-sub">Your email addresses and how notifications are sent. Each form’s own settings are under the form.</p>
    </div>
  </header>

  <ResendKey client:load />
</App>
