---
/**
 * One page per competitor in config/compare.ts: /vs/formspree, /vs/web3forms, /vs/formsubmit.
 * The facts (rows/cells) are shared with the homepage's Compare section so the two can't drift;
 * config/vs.ts holds the prose that's specific to each page.
 */
import Marketing from '../../layouts/Marketing.astro';
import Compare from '../../components/home/Compare.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import Icon from '../../components/ui/Icon.astro';
import { competitors, fairPoints } from '../../config/compare';
import { vsFor } from '../../config/vs';
import { site } from '../../config/site';

export function getStaticPaths() {
  return competitors.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params as { slug: string };
const competitor = competitors.find((c) => c.slug === slug)!;
const content = vsFor(slug)!;
const others = competitors.filter((c) => c.slug !== slug);

const title = `sendm8 vs ${competitor.name}: free, open-source alternative`;
const h1Name = competitor.name;
const description = content.description;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'sendm8', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Compare', item: `${site.url}/#compare` },
    { '@type': 'ListItem', position: 3, name: `sendm8 vs ${competitor.name}`, item: `${site.url}/vs/${slug}/` },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Marketing title={title} bareTitle description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="wrap vs-hero" aria-labelledby="vs-title">
    <p class="crumb label muted">
      <a href="/#compare">Compare</a> <span aria-hidden="true">/</span> {competitor.name}
    </p>
    <p class="bay label label-lg"><span class="bay-no">vs</span> {competitor.name}</p>

    <h1 id="vs-title" class="h1">sendm8 vs <span class="muted">{h1Name}</span></h1>
    <p class="lede">{content.intro}</p>
    <p class="checked label muted">
      Their facts last checked <time datetime={competitor.checkedOn}>{competitor.checkedOnLabel}</time>, from their own pricing and docs pages.
    </p>

    <div class="vs-cta">
      <a class="btn btn-signal btn-lg" href="/app/onboarding">Get your endpoint <Icon name="arrow-right" /></a>
      <a class="btn btn-ghost btn-lg" href="#table">See the full table</a>
    </div>

    <ul class="vs-hl" role="list">
      {
        content.highlights.map((h) => (
          <li>
            <Icon name="check" size={18} class="vs-hl-icon" />
            <span>{h}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Compare
    id="table"
    bayNo="01"
    kicker={`sendm8 vs ${competitor.name}`}
    titleMain="Side by side,"
    titleSub="free plan only."
    competitors={[competitor]}
    fairPoints={fairPoints.filter((p) => p.who === competitor.name)}
  />

  <section class="wrap vs-pick" aria-labelledby="vs-pick-title">
    <p class="bay label label-lg"><span class="bay-no">02</span> When they’re the better pick</p>
    <h2 id="vs-pick-title" class="h2">Pick {competitor.name} instead if…</h2>
    <ul class="pick" role="list">
      {content.pickThemIf.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="wrap vs-switch" aria-labelledby="vs-switch-title">
    <p class="bay label label-lg"><span class="bay-no">03</span> Switching</p>
    <h2 id="vs-switch-title" class="h2">Moving from {competitor.name}.</h2>
    <p class="switch-intro">{content.switching.intro}</p>
    <div class="switch-code">
      <CodeBlock {...content.switching.before} />
      <CodeBlock {...content.switching.after} />
    </div>
    <ul class="switch-notes" role="list">
      {content.switching.notes.map((n) => <li set:html={n} />)}
    </ul>
    <p><a class="link-signal" href={content.switching.cta.href}>{content.switching.cta.label} →</a></p>
    {content.related?.map((r) => <p><a class="link-signal" href={r.href}>{r.label} →</a></p>)}
  </section>

  <section class="wrap vs-faq" aria-labelledby="vs-faq-title">
    <p class="bay label label-lg"><span class="bay-no">04</span> Questions people actually ask</p>
    <h2 id="vs-faq-title" class="h2">Before you switch.</h2>
    <dl class="faq">
      {
        content.faq.map((f) => (
          <div class="faq-item">
            <dt class="faq-q">{f.q}</dt>
            <dd class="faq-a">{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap vs-other">
    <p class="label muted">
      Comparing another service?{' '}
      {others.map((c, i) => (
        <>
          {i > 0 && ' · '}
          <a class="link-signal" href={`/vs/${c.slug}/`}>sendm8 vs {c.name}</a>
        </>
      ))}
    </p>
  </section>
</Marketing>

<style>
  .vs-hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  .crumb {
    display: flex;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .crumb a {
    color: var(--fg-muted);
  }
  .crumb a:hover {
    color: var(--fg);
  }
  .bay {
    margin-top: var(--s-3);
  }
  .h1 {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-stretch: 64%;
    font-weight: 900;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 62ch;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .vs-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .vs-hl {
    display: grid;
    gap: var(--s-3);
    max-width: 62ch;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: var(--s-5);
    border-top: var(--bw-heavy) solid var(--line-strong);
  }
  .vs-hl li {
    display: flex;
    align-items: start;
    gap: var(--s-3);
    font-size: var(--fs-md);
  }
  .vs-hl :global(.vs-hl-icon) {
    flex: none;
    margin-top: 0.15em;
    color: var(--ok);
  }

  .checked {
    margin-top: var(--s-3);
  }
  .vs-pick,
  .vs-switch {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .pick,
  .switch-notes {
    display: grid;
    gap: var(--s-3);
    max-width: 70ch;
    margin-top: var(--s-5);
    padding-left: 1.2rem;
    list-style: square;
    line-height: 1.6;
  }
  .switch-intro {
    margin-top: var(--s-4);
    max-width: 62ch;
    color: var(--fg-muted);
    font-size: var(--fs-md);
  }
  .switch-code {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .switch-code > :global(*) {
    min-width: 0;
  }
  .vs-switch > p:not(.switch-intro) {
    margin-top: var(--s-4);
  }
  @media (max-width: 860px) {
    .switch-code {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .vs-faq {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .h2 {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 850;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .faq {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 0;
    max-width: 70ch;
    border-top: 1px solid var(--line);
  }
  .faq-item {
    padding-block: var(--s-5);
    border-bottom: 1px dashed var(--line);
  }
  .faq-q {
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .faq-a {
    margin-top: var(--s-2);
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .vs-other {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
</style>
