---
/**
 * The homepage. Concept: "HTML in, mail out". The page shows the trip from one line of HTML
 * to the message that lands, and puts a checkable fact beside every claim.
 */
import Marketing from '../layouts/Marketing.astro';
import Hero from '../components/home/Hero.astro';
import TryIt from '../components/home/TryIt.astro';
import Setup from '../components/home/Setup.astro';
import Plan from '../components/home/Plan.astro';
import Bill from '../components/home/Bill.astro';
import RunIt from '../components/home/RunIt.astro';
import FreePlans from '../components/home/FreePlans.astro';
import { site } from '../config/site';

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'sendm8',
  url: site.url,
  description: site.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  isAccessibleForFree: true,
};
---

<Marketing>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <Hero />
  <TryIt />
  <Setup />
  <Plan />
  <Bill />
  <RunIt />
  <FreePlans />
</Marketing>

<script>
  import { addressFor, endpointFor, isEmail, replyToFor, snippetFor, webhookBody, type Fields } from '../components/home/previewLogic';
  import { site } from '../config/site';

  const base = site.endpointBase;
  const $all = <T extends Element>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

  // ---- The endpoint line: what they type flows into the snippet, every copy button and the email's To. ----
  const input = document.querySelector<HTMLInputElement>('#rd-email');
  function syncEndpoint() {
    const value = input?.value ?? '';
    const snippet = snippetFor(base, value);
    for (const b of $all<HTMLElement>('[data-rd-copy]')) b.dataset.copy = snippet;
    for (const el of $all<HTMLElement>('[data-rd-endpoint-text]')) el.textContent = snippet;
    for (const el of $all<HTMLElement>('[data-rd-to]')) el.textContent = addressFor(value);
    if (input) {
      input.style.width = `calc(${Math.max(8, addressFor(value).length)}ch + 2px)`;
      input.setAttribute('aria-invalid', value.trim() !== '' && !isEmail(value) ? 'true' : 'false');
      input.title = endpointFor(base, value);
    }
  }
  input?.addEventListener('input', syncEndpoint);
  syncEndpoint();

  // ---- The try-it form: every channel preview follows the fields. ----
  const form = document.querySelector<HTMLFormElement>('[data-rd-form]');
  const createdAt = new Date();
  createdAt.setSeconds(0, 0);
  const webhookOpts = { id: '01j8x3k6v7m2q9w4e5r6t7y8u9', createdAt: createdAt.toISOString(), referrer: 'https://yoursite.com/contact' };

  function readFields(): Fields {
    const get = (n: string) => (form?.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
    return { name: get('name'), email: get('email'), message: get('message') };
  }
  function syncPreviews() {
    const f = readFields();
    for (const el of $all<HTMLElement>('[data-rd-field]')) {
      const key = el.dataset.rdField as keyof Fields;
      el.textContent = f[key].trim();
    }
    for (const el of $all<HTMLElement>('[data-rd-replyto]')) el.textContent = replyToFor(f) ?? '(none)';
    for (const el of $all<HTMLElement>('[data-rd-when]')) el.textContent = `${createdAt.toUTCString()} from ${webhookOpts.referrer}`;
    const wh = document.querySelector<HTMLElement>('[data-rd-webhook]');
    if (wh) wh.textContent = webhookBody(f, webhookOpts);
  }
  form?.addEventListener('input', syncPreviews);
  syncPreviews();

  // ---- Channel tabs (WAI-ARIA tabs: arrows move, Home/End jump). ----
  const tabs = $all<HTMLButtonElement>('.rt-tab');
  function select(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
    if (focus) tab.focus();
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length], true);
    });
  });
</script>
