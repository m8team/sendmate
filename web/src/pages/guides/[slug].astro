---
/**
 * One page per guide in config/guides: "Contact form on <platform>" and "Send an HTML form to <destination>".
 * The FAQ is rendered on the page, so its FAQPage JSON-LD describes visible content.
 */
import Marketing from '../../layouts/Marketing.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import Callout from '../../components/docs/Callout.astro';
import Icon from '../../components/ui/Icon.astro';
import { guides, guideFor } from '../../config/guides';
import { competitors } from '../../config/compare';
import { docsSections } from '../../components/docs/sections/docsSections';
import { site } from '../../config/site';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params as { slug: string };
const guide = guideFor(slug)!;
const siblings = guides.filter((g) => g.kind === guide.kind && g.slug !== slug);
const docs = guide.related.docs.map((id) => docsSections.find((s) => s.id === id)!);
const vs = guide.related.vs.map((s) => competitors.find((c) => c.slug === s)!).filter(Boolean);
const url = `${site.url}/guides/${slug}/`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'sendm8', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.url}/guides/` },
    { '@type': 'ListItem', position: 3, name: guide.h1, item: url },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Marketing title={guide.title} description={guide.description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <article class="wrap guide">
    <header class="guide-hero">
      <p class="crumb label muted">
        <a href="/guides/">Guides</a> <span aria-hidden="true">/</span> {guide.name}
      </p>
      <h1 class="guide-h1">{guide.h1}</h1>
      <p class="lede">{guide.intro}</p>
    </header>

    <div class="guide-body">
      {
        guide.blocks.map((b) =>
          'h2' in b ? (
            <h2 class="guide-h2">{b.h2}</h2>
          ) : 'p' in b ? (
            <div class="prose">
              <p set:html={b.p} />
            </div>
          ) : 'steps' in b ? (
            <ol class="steps prose" role="list">
              {b.steps.map((s, i) => (
                <li>
                  <span class="step-no mono" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span set:html={s} />
                </li>
              ))}
            </ol>
          ) : 'code' in b ? (
            <CodeBlock code={b.code} lang={b.lang} filename={b.filename} highlight={b.highlight} class="guide-code" />
          ) : (
            <Callout title={b.title} kind={b.kind ?? 'info'}>
              <p set:html={b.note} />
            </Callout>
          ),
        )
      }

      <section class="guide-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="guide-h2">Questions</h2>
        <dl class="faq">
          {
            guide.faq.map((f) => (
              <div class="faq-item">
                <dt class="faq-q">{f.q}</dt>
                <dd class="faq-a">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <nav class="guide-more" aria-label="Related">
        <div>
          <h2 class="label">In the docs</h2>
          <ul role="list">
            {
              docs.map((d) => (
                <li>
                  <a class="link-signal" href={`/docs/${d.id}/`}>
                    {d.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="label">Coming from elsewhere?</h2>
          <ul role="list">
            {
              vs.map((c) => (
                <li>
                  <a class="link-signal" href={`/vs/${c.slug}/`}>
                    sendm8 vs {c.name}
                  </a>
                </li>
              ))
            }
            <li><a class="link-signal" href="/formspree-alternative/">A free Formspree alternative</a></li>
          </ul>
        </div>
        <div>
          <h2 class="label">{guide.kind === 'platform' ? 'Other platforms' : 'Other destinations'}</h2>
          <ul role="list">
            {
              siblings.map((g) => (
                <li>
                  <a class="link-signal" href={`/guides/${g.slug}/`}>
                    {g.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div class="guide-cta">
        <a class="btn btn-signal btn-lg" href="/app/onboarding">Get your endpoint <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost btn-lg" href="/form-to-email/">Just want form to email?</a>
      </div>
    </div>
  </article>
</Marketing>

<style>
  .guide {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .crumb {
    display: flex;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .crumb a {
    color: var(--fg-muted);
  }
  .crumb a:hover {
    color: var(--fg);
  }
  .guide-h1 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-stretch: 64%;
    font-weight: 900;
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 62ch;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .guide-body {
    display: grid;
    gap: var(--s-4);
    max-width: 78ch;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: var(--s-5);
    border-top: var(--bw-heavy) solid var(--line-strong);
  }
  .guide-body > :global(*) {
    min-width: 0;
  }
  /* Long inline URLs (endpoints, the Telegram getUpdates link) wrap instead of widening the page. */
  .guide-body :global(:not(pre) > code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .guide-h2 {
    margin-top: var(--s-5);
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 850;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .steps {
    display: grid;
    gap: var(--s-3);
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
  }
  .step-no {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .faq {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .faq-item {
    padding-block: var(--s-4);
    border-bottom: 1px dashed var(--line);
  }
  .faq-q {
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .faq-a {
    margin-top: var(--s-2);
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .guide-more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .guide-more ul {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .guide-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  @media (max-width: 520px) {
    .guide-cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
