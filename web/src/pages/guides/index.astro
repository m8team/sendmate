---
/**
 * /guides: every platform and destination guide in config/guides, in two lists.
 */
import Marketing from '../../layouts/Marketing.astro';
import { guides } from '../../config/guides';

const groups = [
  { title: 'Add a contact form to…', kind: 'platform' as const },
  { title: 'Send an HTML form to…', kind: 'destination' as const },
];
---

<Marketing
  title="Guides: contact forms for static sites"
  description="Step-by-step guides to adding a working contact form to GitHub Pages, Astro, Hugo, Jekyll, Eleventy and Next.js, and sending it to Discord, Slack or Telegram."
>
  <section class="wrap gi">
    <p class="label label-lg muted">Guides</p>
    <h1 class="gi-h1">Forms for sites with no server.</h1>
    <p class="lede">
      Each guide has a form you can paste in and test straight away, then the details for that platform or destination. New to sendm8? Start with
      <a class="link-signal" href="/form-to-email/">form to email</a>.
    </p>

    <div class="gi-groups">
      {
        groups.map((g) => (
          <section aria-labelledby={`gi-${g.kind}`}>
            <h2 id={`gi-${g.kind}`} class="gi-h2">
              {g.title}
            </h2>
            <ul role="list" class="gi-list">
              {guides
                .filter((x) => x.kind === g.kind)
                .map((x) => (
                  <li>
                    <a href={`/guides/${x.slug}/`}>
                      <span class="gi-name">{x.name}</span>
                      <span class="gi-desc">{x.description}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Marketing>

<style>
  .gi {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .gi-h1 {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-stretch: 64%;
    font-weight: 900;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 0.9;
  }
  .lede {
    margin-top: var(--s-5);
    max-width: 62ch;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .gi-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gi-h2 {
    padding-bottom: var(--s-3);
    border-bottom: var(--bw-heavy) solid var(--line-strong);
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 850;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .gi-list a {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-bottom: 1px dashed var(--line);
    color: inherit;
    text-decoration: none;
  }
  .gi-list a:hover .gi-name {
    color: var(--signal-text);
  }
  .gi-name {
    font-family: var(--font-display);
    font-stretch: var(--stretch-semi);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .gi-desc {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
</style>
