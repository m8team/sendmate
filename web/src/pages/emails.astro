---
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/ui/Icon.astro';
import { submissions, getForm, channelsFor } from '../mocks';
import { limits } from '../config/site';

const form = getForm('k3x9q2m7ab')!;
const sub = submissions.find((s) => s.formId === form.id)!;
const recipient = channelsFor(form.id).find((c) => c.type === 'email')!.target;
const time = new Date(sub.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' });
const subject = `New submission · ${form.name}`;
const preheader = `${sub.data.name}: ${sub.data.message}`;
const src = '/emails/new-submission.html';

const notes = [
  { k: 'Layout', v: 'Nested tables with role="presentation", inline styles, 600px max and fluid below that. It holds together in Outlook, Gmail and Apple Mail.' },
  { k: 'Type', v: 'No web fonts. Arial Narrow stands in for Archivo, Arial for body text and Courier New for the tracking number.' },
  { k: 'Safety', v: 'Every submitted value is HTML-escaped and shown in a table, never rendered as HTML. Reply-To is the sender, so replies skip us entirely.' },
  { k: 'Night', v: 'A prefers-color-scheme block re-inks it for clients that support it. Everywhere else gets the paper version.' },
  { k: 'Privacy', v: 'No tracking pixel, no open tracking, no link redirects. We don’t know if you read it, and we like it that way.' },
  { k: 'Budget', v: `Counts towards ${limits.emailsPerDay} emails a day on our sender. With your own Resend key, it doesn’t.` },
];
---

<Marketing title="Notification email" description="The email you get when your form receives a submission.">
  <section class="wrap em" aria-labelledby="em-title">
    <p class="bay label label-lg"><span class="bay-no">Mail</span> What lands in your inbox</p>

    <div class="em-head">
      <h1 id="em-title" class="h1">Your form’s got mail. <span>Here’s the letter.</span></h1>
      <p class="lede">
        One email per submission, or one digest a day if you’d rather. The fields in a plain table, the tracking number up top, and a reply button that goes straight to the person who wrote in.
      </p>
    </div>

    <!-- Inbox row -->
    <div class="inbox" role="group" aria-label="How it appears in an inbox list">
      <div class="inbox-bar">
        <span class="label">Inbox · {recipient}</span>
        <span class="label muted">1 unread</span>
      </div>
      <a class="inbox-row" href={src} target="_blank" rel="noopener">
        <span class="inbox-dot" aria-hidden="true"></span>
        <span class="inbox-from">sendm8</span>
        <span class="inbox-text">
          <span class="inbox-subject">{subject}</span>
          <span class="inbox-pre"> — {preheader}</span>
        </span>
        <span class="inbox-time mono">{time}</span>
      </a>
    </div>
    <dl class="em-meta">
      <div><dt class="label">From</dt><dd class="mono">sendm8 &lt;notify@sendm8.com&gt;</dd></div>
      <div><dt class="label">Reply-To</dt><dd class="mono">{sub.data.name} &lt;{sub.data.email}&gt;</dd></div>
      <div><dt class="label">Subject</dt><dd class="mono">{subject}</dd></div>
    </dl>

    <!-- Previews -->
    <div class="em-previews">
      <div class="em-toolbar">
        <div class="em-scheme" role="group" aria-label="Preview the email in">
          <button type="button" class="btn btn-xs btn-outline" data-scheme="light" aria-pressed="true">Light mail app</button>
          <button type="button" class="btn btn-xs btn-outline" data-scheme="dark" aria-pressed="false">Dark mail app</button>
        </div>
        <a class="btn btn-sm btn-ghost" href={src} target="_blank" rel="noopener">Open the raw HTML <Icon name="arrow-up-right" size={16} /></a>
      </div>

      <div class="em-frames">
        <figure class="em-frame em-frame-desktop">
          <figcaption class="label muted"><span>Desktop</span><span>640px</span></figcaption>
          <div class="em-scroll">
            <iframe src={src} title="Notification email, desktop width" width="640" height="1100" loading="lazy" data-email-frame></iframe>
          </div>
        </figure>
        <figure class="em-frame em-frame-mobile">
          <figcaption class="label muted"><span>Phone</span><span>375px</span></figcaption>
          <div class="em-scroll em-phone">
            <iframe src={src} title="Notification email, phone width" width="375" height="1300" loading="lazy" data-email-frame></iframe>
          </div>
        </figure>
      </div>
    </div>

    <!-- Notes -->
    <div class="em-notes">
      <h2 class="h3">How it’s built</h2>
      <dl>
        {
          notes.map((n) => (
            <div>
              <dt class="label">{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Marketing>

<script>
  const frames = document.querySelectorAll<HTMLIFrameElement>('[data-email-frame]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-scheme]');

  const fit = (f: HTMLIFrameElement) => {
    const doc = f.contentDocument;
    if (!doc) return;
    // Links in the email point at sendm8.com. In the mockup, keep them on this site.
    doc.querySelectorAll<HTMLAnchorElement>('a[href^="https://sendm8.com/"]').forEach((a) => {
      const url = new URL(a.href);
      a.href = url.pathname + url.search + url.hash;
      a.target = '_top';
    });
    f.style.height = `${doc.documentElement.scrollHeight}px`;
  };

  const setScheme = (scheme: 'light' | 'dark') => {
    frames.forEach((f) => {
      f.style.colorScheme = scheme;
      window.setTimeout(() => fit(f), 60);
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.scheme === scheme)));
  };

  frames.forEach((f) => {
    f.addEventListener('load', () => fit(f));
    if (f.contentDocument?.readyState === 'complete') fit(f);
  });
  buttons.forEach((b) => b.addEventListener('click', () => setScheme(b.dataset.scheme as 'light' | 'dark')));
  setScheme('light');
</script>

<style>
  .em {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--section);
  }
  .em-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-6);
    align-items: end;
    margin-top: var(--s-6);
  }
  .em-head h1 span {
    display: block;
    color: var(--signal);
  }
  .em-head .lede {
    font-size: var(--fs-md);
    color: var(--fg-muted);
  }

  /* ---- Inbox row ---- */
  .inbox {
    margin-top: var(--s-7);
    border: var(--bw-strong) solid var(--line-strong);
    background: var(--bg-raised);
  }
  .inbox-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 0.45rem var(--s-4);
    border-bottom: 1px solid var(--line);
    background: var(--bg-sunk);
  }
  .inbox-row {
    display: grid;
    grid-template-columns: 0.6rem 8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding: 0.85rem var(--s-4);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .inbox-row:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .inbox-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--signal);
  }
  .inbox-from {
    font-weight: 700;
  }
  .inbox-text {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .inbox-subject {
    font-weight: 700;
  }
  .inbox-pre {
    color: var(--fg-muted);
  }
  .inbox-time {
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .em-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-3);
    font-size: var(--fs-xs);
  }
  .em-meta div {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    min-width: 0;
  }
  .em-meta dt {
    color: var(--fg-muted);
  }
  .em-meta dd {
    overflow-wrap: anywhere;
  }

  /* ---- Frames ---- */
  .em-previews {
    margin-top: var(--s-8);
  }
  .em-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: var(--bw-strong) solid var(--line-strong);
  }
  .em-scheme {
    display: flex;
    gap: var(--s-2);
  }
  .em-scheme .btn[aria-pressed='true'] {
    --btn-bg: var(--fg);
    --btn-fg: var(--bg);
  }
  .em-frames {
    display: grid;
    grid-template-columns: minmax(0, 640px) 375px;
    justify-content: start;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: var(--s-5);
  }
  .em-frame {
    min-width: 0;
  }
  .em-frame figcaption {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--s-2);
  }
  .em-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--bg-sunk);
    scrollbar-width: thin;
  }
  .em-scroll iframe {
    display: block;
    border: 0;
    background: #e8e1d3;
  }
  .em-phone {
    width: calc(375px + 16px);
    max-width: 100%;
    border: 8px solid var(--fg);
    border-radius: 28px;
    overflow: hidden;
  }
  .em-phone iframe {
    width: 100%;
  }

  /* ---- Notes ---- */
  .em-notes {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-6);
    margin-top: var(--s-9);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .em-notes dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-6);
  }
  .em-notes dt {
    color: var(--signal-text);
  }
  .em-notes dd {
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  @media (max-width: 1120px) {
    .em-frames {
      grid-template-columns: minmax(0, 1fr);
    }
    .em-frame-desktop {
      max-width: 642px;
    }
  }
  @media (max-width: 900px) {
    .em-head,
    .em-notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .inbox-row {
      grid-template-columns: 0.6rem minmax(0, 1fr) auto;
      grid-template-areas: 'dot from time' '. text text';
      row-gap: 0.15rem;
    }
    .inbox-dot {
      grid-area: dot;
    }
    .inbox-from {
      grid-area: from;
    }
    .inbox-time {
      grid-area: time;
    }
    .inbox-text {
      grid-area: text;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .em-notes dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .em-phone {
      border-width: 6px;
      border-radius: 20px;
    }
  }
</style>
