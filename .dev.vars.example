# sendm8 settings and secrets.
# Production: "Deploy to Cloudflare" asks for these, or set each with `npx wrangler secret put NAME`.
# Local dev: copy to .dev.vars and add the two local-only lines at the bottom.
# Generate random values with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Signs sessions (any long random string).
BETTER_AUTH_SECRET=
# HMAC key for hashing submitter IPs, which are never stored raw (any long random string).
IP_HASH_SECRET=
# Exactly 32 random bytes, base64. Encrypts stored keys and webhook URLs, so keep a copy safe.
ENCRYPTION_KEY=

# The site's public URL, e.g. https://forms.example.com. Leave blank to use the first URL the Worker is visited on.
APP_URL=
# Sender for notification emails. The domain must be verified in Resend, e.g. Forms <notify@example.com>
EMAIL_FROM=
# Resend API key for the shared sender. Blank = emails are logged instead of sent.
RESEND_API_KEY=

# GitHub OAuth app for dashboard sign-in. Callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Google sign-in. Callback URL: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated verified emails allowed to use /app/admin.
ADMIN_EMAILS=
# Optional: Turnstile widget for the spam challenge and report pages. Both blank = challenges off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Discord or Slack webhook that receives free-tier usage alerts.
ALERT_WEBHOOK_URL=

# ── Local development only (never set these in production) ──
# APP_URL=http://localhost:8787
# DEV_LOGIN=true
