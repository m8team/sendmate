{
  "name": "@sendm8/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev -c ../wrangler.jsonc",
    "deploy": "wrangler deploy -c ../wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types -c ../wrangler.jsonc --strict-vars=false ./worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c ../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c ../wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute DB --local -c ../wrangler.jsonc --file=./scripts/seed.sql",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sendm8/shared": "*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ulidx": "^2.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2",
    "@vitest/coverage-istanbul": "4.1.11"
  }
}
